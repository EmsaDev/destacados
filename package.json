{
  "name": "destacados",
  "version": "1.0.0",
  "author": "Nico Solo Dev",
  "description": "prueba de destacados",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.miempresa.miapp",
    "icon": "./public/emsa.ico",
    "productName": "Destacados",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*"
    ],
    "asarUnpack": [
      "backend/**/*",
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.23",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.11.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "konva": "^10.3.0",
    "lucide-react": "^0.542.0",
    "mongoose": "^8.17.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-konva": "^19.2.4",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
